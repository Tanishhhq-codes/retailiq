# Upload backend: FastAPI + PySpark. Needs Java, so it cannot run on Vercel; host it on Render, Railway, Fly.io or a VPS.
#   docker build -f Dockerfile.backend -t retailiq-backend .
#   docker run -p 8000:8000 -e RETAILIQ_CORS_ORIGINS=https://your-site.vercel.app retailiq-backend
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends default-jre-headless && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./requirements.txt
COPY backend ./backend
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY pipeline ./pipeline
ENV RETAILIQ_JOBS_DIR=/data/jobs
EXPOSE 8000
CMD ["sh", "-c", "uvicorn backend.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
