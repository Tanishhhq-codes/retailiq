{
  "name": "retailiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RetailIQ - PySpark data-quality pipeline and analytics dashboard, deployable on Vercel",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:static": "tsc --noEmit && VITE_STATIC=1 vite build",
    "pipeline": "python3 pipeline/run_pipeline.py",
    "test": "python3 -m pytest -q tests"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": { "node": ">=18" }
}
